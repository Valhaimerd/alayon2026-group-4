APP_NAME="CISC SchedFlow"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

LOG_CHANNEL=stack
LOG_LEVEL=warning
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Existing Supabase database/Auth; no service-role key is used.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
HATURIKOSMS_API_KEY=
ACCOUNT_SMS_SERVER_SECRET=
HATURIKOSMS_SEND_ENABLED=false
SCHEDULE_PUBLIC_URL=
